"use client";

import { useEffect, useMemo, useState } from "react";
import { supabase } from "@/lib/supabaseClient";

type QueueStatus =
  | "needs_review"
  | "queued"
  | "evaluating"
  | "decided"
  | "failed"
  | "all";

type SafetyRow = {
  case_id: string;
  content_item_id: string;
  content_type: string;
  entity_type: string;
  entity_id: string | null;
  spot_id: string | null;
  actor_user_id: string | null;
  actor_name: string | null;
  case_status: string;
  priority: number;
  final_action: string | null;
  final_category: string | null;
  final_severity: number | null;
  final_confidence: number | string | null;
  decision_source: string | null;
  explanation_code: string | null;
  explanation_public: string | null;
  explanation_internal: string | null;
  text_content: string | null;
  image_urls: string[];
  locale: string | null;
  context: Record<string, unknown>;
  lifecycle_status: string;
  latest_reason_codes: string[];
  latest_metadata: Record<string, unknown>;
  created_at: string;
};

const statusLabels: Record<string, string> = {
  needs_review: "Prüfung erforderlich",
  queued: "In Warteschlange",
  evaluating: "Wird geprüft",
  decided: "Entschieden",
  failed: "Fehlgeschlagen",
};

const actionLabels: Record<string, string> = {
  allow: "Erlaubt",
  allow_log: "Erlaubt und protokolliert",
  limit: "Begrenzt",
  temporary_hide: "Temporär ausgeblendet",
  remove: "Entfernt",
  block_submit: "Veröffentlichung blockiert",
  escalate: "Eskaliert",
};

const categoryLabels: Record<string, string> = {
  none: "Kein Verstoß",
  hate: "Hass und Diskriminierung",
  harassment: "Belästigung und Ausgrenzung",
  violence: "Gewalt",
  sexual: "Sexuelle Inhalte",
  self_harm: "Selbstgefährdung",
  illicit: "Illegale oder gefährliche Inhalte",
};

const policyCategoryLabels: Record<string, string> = {
  hate_and_discrimination: "Hass und Diskriminierung",
  harassment_and_bullying: "Belästigung und Mobbing",
  violence_and_incitement: "Gewalt und Aufruf zu Gewalt",
  sexual_safety: "Sexuelle Sicherheit",
  self_harm: "Selbstgefährdung",
  fraud_and_deception: "Betrug und Täuschung",
  privacy_and_personal_data: "Privatsphäre und persönliche Daten",
  regulated_and_dangerous_commerce: "Regulierte und gefährliche Angebote",
  none: "Kein Policy-Verstoß",
};

const subcategoryLabels: Record<string, string> = {
  ambiguous_group_exclusion: "Uneindeutige Gruppenausgrenzung",
  discriminatory_exclusion: "Diskriminierender Ausschluss",
  protected_group_attack: "Angriff auf geschützte Gruppe",
  denial_of_service_based_on_identity:
    "Verweigerung aufgrund persönlicher Merkmale",
  none: "Keine Subkategorie",
};

const reasonLabels: Record<string, string> = {
  NO_POLICY_VIOLATION: "Kein Richtlinienverstoß",
  AMBIGUOUS_GROUP_TARGET: "Uneindeutig bezeichnete Zielgruppe",
  EXCLUSION_LANGUAGE: "Ausgrenzende Formulierung",
  HUMAN_CONTEXT_REQUIRED: "Menschliche Kontextprüfung erforderlich",
  LOCAL_POLICY_MATCH: "Backyrd-Policy-Regel getroffen",
  SHADOW_MODE: "Shadow Mode",
  PROTECTED_CHARACTERISTIC: "Geschütztes Merkmal erkannt",
  DENIAL_OF_ACCESS_OR_SERVICE: "Zutritt oder Dienstleistung verweigert",
  DISCRIMINATORY_EXCLUSION: "Diskriminierender Ausschluss",
  LEGITIMATE_BUSINESS_ACCESS_RULE: "Legitime betriebliche Zutrittsregel",
  MODEL_FLAGGED: "Vom Moderationsmodell markiert",
  CATEGORY_THRESHOLD_REACHED: "Kategorie-Schwellenwert erreicht",
};

function formatConfidence(value: number | string | null): string {
  if (value === null || value === undefined) {
    return "—";
  }

  const parsed = Number(value);

  if (!Number.isFinite(parsed)) {
    return "—";
  }

  return `${Math.round(parsed * 100)} %`;
}

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("de-CH", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));
}

function getMetadataString(
  metadata: Record<string, unknown> | null | undefined,
  key: string,
): string | null {
  const value = metadata?.[key];

  return typeof value === "string" ? value : null;
}

function humanizeCode(code: string): string {
  return reasonLabels[code] ??
    code
      .toLowerCase()
      .split("_")
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(" ");
}

export default function SafetyIntegrityPage() {
  const [rows, setRows] = useState<SafetyRow[]>([]);
  const [status, setStatus] = useState<QueueStatus>("needs_review");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(true);
  const [decidingCaseId, setDecidingCaseId] = useState<string | null>(
    null,
  );

  async function load() {
    setLoading(true);
    setError("");

    const { data, error: loadError } = await supabase.rpc(
      "safety_admin_queue_v2",
      {
        p_status: status === "all" ? null : status,
        p_limit: 250,
      },
    );

    if (loadError) {
      setError(loadError.message);
      setRows([]);
    } else {
      setRows((data ?? []) as SafetyRow[]);
    }

    setLoading(false);
  }

  useEffect(() => {
    void load();
  }, [status]);

  const summary = useMemo(() => {
    return {
      total: rows.length,
      highSeverity: rows.filter(
        (row) => (row.final_severity ?? 0) >= 4,
      ).length,
      profileCases: rows.filter(
        (row) => row.content_type === "owner_spot_profile",
      ).length,
    };
  }, [rows]);

  async function decide(
    row: SafetyRow,
    action: "allow" | "limit" | "temporary_hide" | "remove",
  ) {
    const label = actionLabels[action] ?? action;

    const confirmed = window.confirm(
      `Fall wirklich als „${label}“ entscheiden?`,
    );

    if (!confirmed) {
      return;
    }

    const publicExplanation =
      window.prompt(
        "Öffentliche Begründung (optional)",
        action === "allow"
          ? "Der Inhalt verstößt nicht gegen die Backyrd-Richtlinien."
          : "Der Inhalt wurde nach menschlicher Prüfung eingeschränkt.",
      ) || null;

    setDecidingCaseId(row.case_id);
    setError("");

    const { error: decisionError } = await supabase.rpc(
      "safety_admin_decide_v1",
      {
        p_case_id: row.case_id,
        p_action: action,
        p_category: row.final_category,
        p_severity: row.final_severity,
        p_confidence:
          row.final_confidence === null
            ? null
            : Number(row.final_confidence),
        p_public_explanation: publicExplanation,
        p_internal_explanation:
          "Human review via Backyrd Safety & Integrity Admin V2.",
        p_reason_codes: [
          "HUMAN_REVIEW",
          `HUMAN_ACTION_${action.toUpperCase()}`,
        ],
      },
    );

    if (decisionError) {
      setError(decisionError.message);
    } else {
      await load();
    }

    setDecidingCaseId(null);
  }

  return (
    <div className="by-page">
      <div className="by-header">
        <div>
          <h1 className="by-title">Safety & Integrity</h1>
          <div className="by-subtitle">
            Policy-versionierte Moderation, Human Review und Appeals.
          </div>
        </div>
      </div>

      <div
        className="by-card by-section"
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
          gap: 12,
        }}
      >
        <div className="by-panel">
          <div className="by-muted by-small">Fälle im Filter</div>
          <strong style={{ fontSize: 24 }}>{summary.total}</strong>
        </div>
        <div className="by-panel">
          <div className="by-muted by-small">Hohe Severity</div>
          <strong style={{ fontSize: 24 }}>
            {summary.highSeverity}
          </strong>
        </div>
        <div className="by-panel">
          <div className="by-muted by-small">Owner-Profile</div>
          <strong style={{ fontSize: 24 }}>
            {summary.profileCases}
          </strong>
        </div>
      </div>

      <div className="by-card by-section">
        <div className="by-toolbar">
          <select
            className="by-select"
            value={status}
            onChange={(event) =>
              setStatus(event.target.value as QueueStatus)
            }
          >
            <option value="needs_review">
              Prüfung erforderlich
            </option>
            <option value="queued">Warteschlange</option>
            <option value="evaluating">Wird geprüft</option>
            <option value="decided">Entschieden</option>
            <option value="failed">Fehlgeschlagen</option>
            <option value="all">Alle</option>
          </select>

          <button
            className="by-btn by-btn-soft"
            onClick={() => void load()}
            disabled={loading}
          >
            {loading ? "Lädt…" : "Neu laden"}
          </button>
        </div>
      </div>

      {error ? (
        <div
          className="by-card by-section"
          style={{ color: "#ef4444" }}
        >
          {error}
        </div>
      ) : null}

      {!loading && rows.length === 0 ? (
        <div className="by-card by-section">
          <strong>Keine Fälle in diesem Filter</strong>
          <div
            className="by-muted"
            style={{ marginTop: 8 }}
          >
            Neue auffällige Inhalte erscheinen hier automatisch.
          </div>
        </div>
      ) : null}

      {!loading &&
        rows.map((row) => {
          const policyCategory =
            getMetadataString(
              row.latest_metadata,
              "policy_category",
            ) ?? "none";

          const policySubcategory =
            getMetadataString(
              row.latest_metadata,
              "policy_subcategory",
            ) ?? "none";

          const policyVersion =
            getMetadataString(
              row.latest_metadata,
              "policy_version",
            ) ?? "—";

          const canDecide =
            row.case_status === "needs_review";

          return (
            <article
              className="by-card by-section"
              key={row.case_id}
            >
              <div className="by-row">
                <div>
                  <strong>
                    {row.content_type === "owner_spot_profile"
                      ? "Owner-Profil"
                      : row.content_type ===
                          "owner_spot_intelligence"
                        ? "Spot Intelligence"
                        : row.content_type}
                  </strong>

                  <div className="by-muted by-small">
                    {row.actor_name ?? "Unbekannter Nutzer"}
                    {" · "}
                    {row.locale ?? "Sprache offen"}
                    {" · "}
                    {formatDate(row.created_at)}
                  </div>
                </div>

                <span
                  className={
                    row.case_status === "needs_review"
                      ? "by-badge by-badge-yellow"
                      : "by-badge"
                  }
                >
                  {statusLabels[row.case_status] ??
                    row.case_status}
                </span>
              </div>

              {row.text_content ? (
                <div
                  className="by-panel"
                  style={{
                    marginTop: 14,
                    whiteSpace: "pre-wrap",
                    lineHeight: 1.5,
                  }}
                >
                  {row.text_content}
                </div>
              ) : null}

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(4, minmax(0, 1fr))",
                  gap: 10,
                  marginTop: 14,
                }}
              >
                <div className="by-panel">
                  <div className="by-muted by-small">
                    Kategorie
                  </div>
                  <strong>
                    {categoryLabels[
                      row.final_category ?? "none"
                    ] ??
                      row.final_category ??
                      "—"}
                  </strong>
                </div>

                <div className="by-panel">
                  <div className="by-muted by-small">
                    Severity
                  </div>
                  <strong>
                    {row.final_severity ?? "—"} / 5
                  </strong>
                </div>

                <div className="by-panel">
                  <div className="by-muted by-small">
                    Confidence
                  </div>
                  <strong>
                    {formatConfidence(
                      row.final_confidence,
                    )}
                  </strong>
                </div>

                <div className="by-panel">
                  <div className="by-muted by-small">
                    Policy-Version
                  </div>
                  <strong>{policyVersion}</strong>
                </div>
              </div>

              <div
                className="by-panel"
                style={{ marginTop: 10 }}
              >
                <div className="by-muted by-small">
                  Policy-Einstufung
                </div>
                <strong>
                  {policyCategoryLabels[policyCategory] ??
                    policyCategory}
                </strong>
                <div
                  className="by-muted by-small"
                  style={{ marginTop: 4 }}
                >
                  {subcategoryLabels[policySubcategory] ??
                    policySubcategory}
                </div>
              </div>

              {row.latest_reason_codes?.length ? (
                <div
                  style={{
                    display: "flex",
                    gap: 8,
                    flexWrap: "wrap",
                    marginTop: 12,
                  }}
                >
                  {row.latest_reason_codes.map((code) => (
                    <span
                      className="by-badge"
                      key={code}
                    >
                      {humanizeCode(code)}
                    </span>
                  ))}
                </div>
              ) : null}

              {row.explanation_public ? (
                <div
                  className="by-muted by-small"
                  style={{ marginTop: 12 }}
                >
                  {row.explanation_public}
                </div>
              ) : null}

              {canDecide ? (
                <div
                  className="by-actions"
                  style={{ marginTop: 14 }}
                >
                  <button
                    className="by-btn by-btn-blue"
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      void decide(row, "allow")
                    }
                  >
                    Erlauben
                  </button>

                  <button
                    className="by-btn by-btn-soft"
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      void decide(row, "limit")
                    }
                  >
                    Begrenzen
                  </button>

                  <button
                    className="by-btn"
                    style={{
                      background: "#7f1d1d",
                      color: "white",
                    }}
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      void decide(
                        row,
                        "temporary_hide",
                      )
                    }
                  >
                    Temporär ausblenden
                  </button>

                  <button
                    className="by-btn"
                    style={{
                      background: "#450a0a",
                      color: "white",
                    }}
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      void decide(row, "remove")
                    }
                  >
                    Entfernen
                  </button>
                </div>
              ) : (
                <div
                  className="by-panel"
                  style={{ marginTop: 14 }}
                >
                  <div className="by-muted by-small">
                    Entscheidung
                  </div>
                  <strong>
                    {actionLabels[
                      row.final_action ?? ""
                    ] ??
                      row.final_action ??
                      "Noch keine Entscheidung"}
                  </strong>
                </div>
              )}
            </article>
          );
        })}
    </div>
  );
}
