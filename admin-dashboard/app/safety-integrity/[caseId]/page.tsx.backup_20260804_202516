"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import { useEffect, useState } from "react";
import { supabase } from "@/lib/supabaseClient";

type Row = Record<string, unknown>;
type Detail = {
  case: Row;
  content: Row;
  actor: Row | null;
  signals: Row[];
  decision_events: Row[];
  reports: Row[];
  appeals: Row[];
  text_jobs: Row[];
  image_jobs: Row[];
};

const asText = (value: unknown, fallback = "—") =>
  typeof value === "string" && value.trim()
    ? value
    : typeof value === "number" || typeof value === "boolean"
      ? String(value)
      : fallback;

const pretty = (value: unknown) => JSON.stringify(value ?? {}, null, 2);

function Pill({ value }: { value: unknown }) {
  const label = asText(value, "unknown");
  return (
    <span style={{ padding: "6px 10px", borderRadius: 999, border: "1px solid rgba(255,255,255,.12)", background: "rgba(255,255,255,.04)", fontSize: 12, fontWeight: 800 }}>
      {label}
    </span>
  );
}

function Section({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <section className="by-card" style={{ padding: 22, display: "grid", gap: 14 }}>
      <h2 style={{ margin: 0, fontSize: 20 }}>{title}</h2>
      {children}
    </section>
  );
}

export default function SafetyCaseDetailPage() {
  const params = useParams<{ caseId: string }>();
  const caseId = params?.caseId ?? "";
  const [detail, setDetail] = useState<Detail | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [priority, setPriority] = useState(0);
  const [note, setNote] = useState("");
  const [saving, setSaving] = useState(false);

  async function load() {
    setLoading(true);
    setError("");
    const { data, error: rpcError } = await supabase.rpc("safety_admin_case_detail_v1", { p_case_id: caseId });
    if (rpcError) setError(rpcError.message);
    else {
      const loaded = data as Detail;
      setDetail(loaded);
      setPriority(Number(loaded.case?.priority ?? 0));
    }
    setLoading(false);
  }

  useEffect(() => { if (caseId) void load(); }, [caseId]);

  async function savePriority() {
    setSaving(true);
    const { error: rpcError } = await supabase.rpc("safety_admin_set_case_priority_v1", {
      p_case_id: caseId,
      p_priority: priority,
      p_internal_note: note.trim() || null,
    });
    setSaving(false);
    if (rpcError) setError(rpcError.message);
    else { setNote(""); await load(); }
  }

  if (loading) return <div className="by-page"><div className="by-card by-section">Moderationsfall wird geladen …</div></div>;
  if (!detail) return <div className="by-page"><Link href="/safety-integrity">← Zurück</Link><div className="by-card by-section" style={{ color: "#ff8585", marginTop: 18 }}>{error || "Fall nicht gefunden"}</div></div>;

  const images = Array.isArray(detail.content.image_urls) ? detail.content.image_urls : [];

  return (
    <div className="by-page" style={{ padding: "32px 34px 60px", maxWidth: 1560, margin: "0 auto" }}>
      <Link href="/safety-integrity" style={{ color: "#aeb4bf", textDecoration: "none", fontWeight: 800 }}>← Zurück zur Moderationskonsole</Link>
      <header style={{ margin: "24px 0", display: "flex", justifyContent: "space-between", gap: 18 }}>
        <div><div style={{ color: "#ff4f8b", fontWeight: 900, textTransform: "uppercase", fontSize: 12 }}>Moderationsfall</div><h1 className="by-title" style={{ margin: "8px 0" }}>{asText(detail.content.entity_type, "Safety Case")}</h1><div className="by-muted">{caseId}</div></div>
        <div style={{ display: "flex", gap: 8 }}><Pill value={detail.case.case_status} /><Pill value={detail.case.final_action} /></div>
      </header>

      {error ? <div className="by-card" style={{ padding: 16, marginBottom: 18, color: "#ff8585" }}>{error}</div> : null}

      <div style={{ display: "grid", gridTemplateColumns: "minmax(0,1.4fr) minmax(330px,.7fr)", gap: 18, alignItems: "start" }}>
        <div style={{ display: "grid", gap: 18 }}>
          <Section title="Inhalt">
            <div style={{ padding: 18, borderRadius: 16, background: "rgba(0,0,0,.22)", whiteSpace: "pre-wrap", lineHeight: 1.6 }}>{asText(detail.content.text_content, "Kein Text vorhanden.")}</div>
            {images.length ? <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(240px,1fr))", gap: 12 }}>{images.map((image, index) => { const ref = asText(image); const http = ref.startsWith("https://"); return <div key={`${ref}-${index}`} style={{ border: "1px solid rgba(255,255,255,.08)", borderRadius: 14, overflow: "hidden" }}>{http ? <a href={ref} target="_blank" rel="noreferrer"><img src={ref} alt={`Bild ${index + 1}`} style={{ width: "100%", height: 300, objectFit: "contain", background: "#070708" }} /></a> : <div style={{ minHeight: 160, display: "grid", placeItems: "center", color: "#aeb4bf" }}>Privater Storage-Pfad</div>}<div style={{ padding: 10, fontSize: 11, overflowWrap: "anywhere", color: "#aeb4bf" }}>{ref}</div></div>; })}</div> : <div className="by-muted">Keine Bilder hinterlegt.</div>}
          </Section>

          <Section title={`Moderationssignale · ${detail.signals.length}`}>
            {detail.signals.length ? detail.signals.map((row, index) => <details key={asText(row.id, String(index))} style={{ padding: 14, border: "1px solid rgba(255,255,255,.08)", borderRadius: 12 }}><summary style={{ cursor: "pointer", fontWeight: 850 }}>{asText(row.signal_type, "Signal")} · {asText(row.provider)} · flagged={asText(row.flagged)}</summary><pre style={{ whiteSpace: "pre-wrap", overflowWrap: "anywhere", fontSize: 11 }}>{pretty(row)}</pre></details>) : <div className="by-muted">Keine Signale.</div>}
          </Section>

          <Section title={`Entscheidungshistorie · ${detail.decision_events.length}`}>
            {detail.decision_events.length ? detail.decision_events.map((row, index) => <div key={asText(row.id, String(index))} style={{ padding: 14, border: "1px solid rgba(255,255,255,.08)", borderRadius: 12 }}><div style={{ display: "flex", justifyContent: "space-between", gap: 10 }}><strong>{asText(row.action)}</strong><Pill value={row.source} /></div><pre style={{ whiteSpace: "pre-wrap", overflowWrap: "anywhere", fontSize: 11 }}>{pretty({ reason_codes: row.reason_codes, metadata: row.metadata, created_at: row.created_at })}</pre></div>) : <div className="by-muted">Noch keine Entscheidung.</div>}
          </Section>

          <Section title={`Verarbeitungsjobs · ${detail.text_jobs.length + detail.image_jobs.length}`}>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(2,minmax(0,1fr))", gap: 12 }}><div><h3>Text</h3>{detail.text_jobs.map((job, index) => <div key={asText(job.id, String(index))} style={{ padding: 12, marginTop: 8, border: "1px solid rgba(255,255,255,.08)", borderRadius: 12 }}><Pill value={job.status} />{job.last_error ? <div style={{ marginTop: 8, color: "#ff8585", fontSize: 11 }}>{asText(job.last_error)}</div> : null}</div>)}</div><div><h3>Bilder</h3>{detail.image_jobs.map((job, index) => <div key={asText(job.id, String(index))} style={{ padding: 12, marginTop: 8, border: "1px solid rgba(255,255,255,.08)", borderRadius: 12 }}><Pill value={job.status} /><div className="by-muted by-small" style={{ marginTop: 8 }}>Bild {Number(job.image_index ?? 0) + 1}</div>{job.last_error ? <div style={{ marginTop: 8, color: "#ffc36b", fontSize: 11 }}>{asText(job.last_error)}</div> : null}</div>)}</div></div>
          </Section>
        </div>

        <aside style={{ display: "grid", gap: 18 }}>
          <Section title="Fallübersicht">{[["Status", detail.case.case_status],["Priorität", detail.case.priority],["Aktion", detail.case.final_action],["Kategorie", detail.case.final_category],["Schweregrad", detail.case.final_severity],["Confidence", detail.case.final_confidence],["Lifecycle", detail.content.lifecycle_status]].map(([label,value]) => <div key={String(label)} style={{ display: "flex", justifyContent: "space-between", gap: 14, borderBottom: "1px solid rgba(255,255,255,.05)", paddingBottom: 9 }}><span className="by-muted by-small">{String(label)}</span><strong>{asText(value)}</strong></div>)}</Section>
          <Section title="Priorisierung"><input type="number" min={0} max={100} value={priority} onChange={(e) => setPriority(Math.max(0, Math.min(100, Number(e.target.value))))} style={{ width: "100%", padding: 12, borderRadius: 12, background: "rgba(255,255,255,.04)", color: "inherit", border: "1px solid rgba(255,255,255,.1)" }} /><textarea rows={4} placeholder="Interne Begründung …" value={note} onChange={(e) => setNote(e.target.value)} style={{ width: "100%", padding: 12, borderRadius: 12, background: "rgba(255,255,255,.04)", color: "inherit", border: "1px solid rgba(255,255,255,.1)" }} /><button className="by-btn by-btn-blue" disabled={saving} onClick={() => void savePriority()}>{saving ? "Wird gespeichert …" : "Priorität speichern"}</button></Section>
          <Section title="Betroffener Nutzer"><strong>{asText(detail.actor?.display_name, "Kein Nutzer")}</strong><div className="by-muted">@{asText(detail.actor?.username)}</div></Section>
          <Section title="Verknüpfungen"><div><strong>{detail.reports.length}</strong> Meldungen</div><div><strong>{detail.appeals.length}</strong> Einsprüche</div></Section>
          <Section title="Interne Erklärung"><div style={{ whiteSpace: "pre-wrap", color: "#c5cad3" }}>{asText(detail.case.explanation_internal, "Keine interne Erklärung.")}</div></Section>
        </aside>
      </div>
    </div>
  );
}
