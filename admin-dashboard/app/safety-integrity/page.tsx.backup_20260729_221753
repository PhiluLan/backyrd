                style={{ marginTop: 8 }}
              >
                Neue auffällige Inhalte erscheinen hier automatisch.
              </div>
            </div>
          </div>
        </div>
      ) : null}

      {!loading &&
        rows.map((row) => {
          const policyCategory =
            getMetadataString(
              row.latest_metadata,
              "policy_category",
            ) ?? "none";

          const policySubcategory =
            getMetadataString(
              row.latest_metadata,
