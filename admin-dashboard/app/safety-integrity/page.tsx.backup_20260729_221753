};

function formatConfidence(value: number | string | null): string {
  if (value === null || value === undefined) {
    return "—";
  }

  const parsed = Number(value);

  if (!Number.isFinite(parsed)) {
    return "—";
  }

  return `${Math.round(parsed * 100)} %`;
}

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("de-CH", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));
}

function getMetadataString(
  metadata: Record<string, unknown> | null | undefined,
  key: string,
): string | null {
  const value = metadata?.[key];

  return typeof value === "string" ? value : null;
}

function humanizeCode(code: string): string {
  return reasonLabels[code] ??
    code
      .toLowerCase()
      .split("_")
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(" ");
}

export default function SafetyIntegrityPage() {
  const [rows, setRows] = useState<SafetyRow[]>([]);
  const [status, setStatus] = useState<QueueStatus>("needs_review");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(true);
  const [decidingCaseId, setDecidingCaseId] = useState<string | null>(
    null,
  );
  const [decisionDraft, setDecisionDraft] =
    useState<DecisionDraft>(null);

  async function load() {
    setLoading(true);
    setError("");

    const { data, error: loadError } = await supabase.rpc(
      "safety_admin_queue_v2",
      {
        p_status: status === "all" ? null : status,
        p_limit: 250,
      },
    );

    if (loadError) {
      setError(loadError.message);
      setRows([]);
    } else {
      setRows((data ?? []) as SafetyRow[]);
    }

    setLoading(false);
  }

  useEffect(() => {
    void load();
  }, [status]);

  const summary = useMemo(() => {
    return {
      total: rows.length,
      highSeverity: rows.filter(
        (row) => (row.final_severity ?? 0) >= 4,
      ).length,
      profileCases: rows.filter(
        (row) => row.content_type === "owner_spot_profile",
      ).length,
    };
  }, [rows]);

  function defaultExplanation(
    action: ModerationAction,
  ): string {
    const defaults: Record<ModerationAction, string> = {
      allow:
        "Der Inhalt verstößt nicht gegen die Backyrd-Richtlinien.",
      limit:
        "Der Inhalt wurde nach menschlicher Prüfung begrenzt.",
      temporary_hide:
        "Der Inhalt wurde vorübergehend ausgeblendet und wird weiter geprüft.",
      remove:
        "Der Inhalt wurde nach menschlicher Prüfung entfernt.",
    };

    return defaults[action];
  }

  function openDecisionModal(
    row: SafetyRow,
    action: ModerationAction,
  ) {
    setDecisionDraft({
      row,
      action,
      explanation: defaultExplanation(action),
    });
  }

  function closeDecisionModal() {
    if (decidingCaseId) {
      return;
    }

    setDecisionDraft(null);
  }

  async function submitDecision() {
    if (!decisionDraft) {
      return;
    }

    const { row, action, explanation } = decisionDraft;

    setDecidingCaseId(row.case_id);
    setError("");

    const { error: decisionError } = await supabase.rpc(
      "safety_admin_decide_v1",
      {
        p_case_id: row.case_id,
        p_action: action,
        p_category: row.final_category,
        p_severity: row.final_severity,
        p_confidence:
          row.final_confidence === null
            ? null
            : Number(row.final_confidence),
        p_public_explanation:
          explanation.trim() || null,
        p_internal_explanation:
          "Human review via Backyrd Safety & Integrity Admin V2.",
        p_reason_codes: [
          "HUMAN_REVIEW",
          `HUMAN_ACTION_${action.toUpperCase()}`,
        ],
      },
    );

    if (decisionError) {
      setError(decisionError.message);
      setDecidingCaseId(null);
      return;
    }

    setDecisionDraft(null);
    setDecidingCaseId(null);
    await load();
  }

  return (
    <div className="by-page">
      <div
        className="by-header"
        style={{
          alignItems: "flex-start",
          marginBottom: 28,
        }}
      >
        <div>
          <div
            className="by-badge"
            style={{
              display: "inline-flex",
              marginBottom: 12,
              background: "rgba(255, 54, 125, 0.08)",
              color: "#ff4f8b",
              borderColor: "rgba(255, 79, 139, 0.18)",
            }}
          >
            Trust Operations
          </div>
          <h1
            className="by-title"
            style={{
              fontSize: "clamp(34px, 4vw, 54px)",
              lineHeight: 1,
              letterSpacing: "-0.035em",
            }}
          >
            Safety & Integrity
          </h1>
          <div
            className="by-subtitle"
            style={{
              maxWidth: 720,
              marginTop: 12,
              fontSize: 17,
              lineHeight: 1.55,
            }}
          >
            Policy-versionierte Moderation, menschliche Entscheidungen
            und nachvollziehbare Enforcement-Historie.
          </div>
        </div>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
          gap: 14,
          marginBottom: 18,
        }}
      >
        {[
          {
            label: "Fälle im Filter",
            value: summary.total,
            hint: "Aktuelle Ansicht",
          },
          {
            label: "Hohe Severity",
            value: summary.highSeverity,
            hint: "Severity 4–5",
          },
          {
            label: "Owner-Profile",
            value: summary.profileCases,
            hint: "Spot-Inhalte",
          },
        ].map((item) => (
          <div
            key={item.label}
            className="by-card"
            style={{
              padding: 18,
              minHeight: 112,
              display: "flex",
              flexDirection: "column",
              justifyContent: "space-between",
              background:
                "linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.012))",
              borderColor: "rgba(255,255,255,0.08)",
            }}
          >
            <div
              className="by-muted by-small"
              style={{ fontWeight: 600 }}
            >
              {item.label}
            </div>
            <div
              style={{
                display: "flex",
                alignItems: "flex-end",
                justifyContent: "space-between",
                gap: 12,
                marginTop: 18,
              }}
            >
              <strong
                style={{
                  fontSize: 34,
                  lineHeight: 1,
                  letterSpacing: "-0.03em",
                }}
              >
                {item.value}
              </strong>
              <span className="by-muted by-small">
                {item.hint}
              </span>
            </div>
          </div>
        ))}
      </div>

      <div
        className="by-card by-section"
        style={{
          padding: 14,
          marginBottom: 24,
          background: "rgba(255,255,255,0.018)",
        }}
      >
        <div className="by-toolbar">
          <select
            className="by-select"
            value={status}
            onChange={(event) =>
              setStatus(event.target.value as QueueStatus)
            }
          >
            <option value="needs_review">
              Prüfung erforderlich
            </option>
            <option value="queued">Warteschlange</option>
            <option value="evaluating">Wird geprüft</option>
            <option value="decided">Entschieden</option>
            <option value="failed">Fehlgeschlagen</option>
            <option value="all">Alle</option>
          </select>

          <button
            className="by-btn by-btn-soft"
            onClick={() => void load()}
            disabled={loading}
          >
            {loading ? "Lädt…" : "Neu laden"}
          </button>
        </div>
      </div>

      {error ? (
        <div
          className="by-card by-section"
          style={{ color: "#ef4444" }}
        >
          {error}
        </div>
      ) : null}

      {!loading && rows.length === 0 ? (
        <div className="by-card by-section">
