                    Geprüfter Inhalt
                  </div>
                  <div
                    className="by-panel"
                    style={{
                      whiteSpace: "pre-wrap",
                      lineHeight: 1.55,
                      padding: 18,
                      fontSize: 17,
                      borderRadius: 16,
                      background: "rgba(0,0,0,0.18)",
                    }}
                  >
                    {row.text_content}
                  </div>
                </div>
              ) : null}

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "repeat(4, minmax(0, 1fr))",
                  gap: 10,
                  marginTop: 14,
                  padding: "0 22px",
                }}
              >
                <div
                  className="by-panel"
                  style={{
                    minHeight: 92,
                    padding: 14,
                    display: "flex",
                    flexDirection: "column",
                    justifyContent: "space-between",
                    background: "rgba(255,255,255,0.018)",
                  }}
                >
                  <div className="by-muted by-small">
                    Kategorie
                  </div>
                  <strong>
                    {categoryLabels[
                      row.final_category ?? "none"
                    ] ??
                      row.final_category ??
                      "—"}
                  </strong>
                </div>

                <div
                  className="by-panel"
                  style={{
                    minHeight: 92,
                    padding: 14,
                    display: "flex",
                    flexDirection: "column",
                    justifyContent: "space-between",
                    background: "rgba(255,255,255,0.018)",
                  }}
                >
                  <div className="by-muted by-small">
                    Severity
                  </div>
                  <strong>
                    {row.final_severity ?? "—"} / 5
                  </strong>
                </div>

                <div
                  className="by-panel"
                  style={{
                    minHeight: 92,
                    padding: 14,
                    display: "flex",
                    flexDirection: "column",
                    justifyContent: "space-between",
                    background: "rgba(255,255,255,0.018)",
                  }}
                >
                  <div className="by-muted by-small">
                    Confidence
                  </div>
                  <strong>
                    {formatConfidence(
                      row.final_confidence,
                    )}
                  </strong>
                </div>

                <div
                  className="by-panel"
                  style={{
                    minHeight: 92,
                    padding: 14,
                    display: "flex",
                    flexDirection: "column",
                    justifyContent: "space-between",
                    background: "rgba(255,255,255,0.018)",
                  }}
                >
                  <div className="by-muted by-small">
                    Policy-Version
                  </div>
                  <strong>{policyVersion}</strong>
                </div>
              </div>

              <div
                className="by-panel"
                style={{
                  margin: "12px 22px 0",
                  padding: 16,
                  background: "rgba(255,255,255,0.018)",
                }}
              >
                <div className="by-muted by-small">
                  Policy-Einstufung
                </div>
                <strong>
                  {policyCategoryLabels[policyCategory] ??
                    policyCategory}
                </strong>
                <div
                  className="by-muted by-small"
                  style={{ marginTop: 4 }}
                >
                  {subcategoryLabels[policySubcategory] ??
                    policySubcategory}
                </div>
              </div>

              {row.latest_reason_codes?.length ? (
                <div
                  style={{
                    display: "flex",
                    gap: 8,
                    flexWrap: "wrap",
                    margin: "14px 22px 0",
                  }}
                >
                  {row.latest_reason_codes.map((code) => (
                    <span
                      className="by-badge"
                      key={code}
                    >
                      {humanizeCode(code)}
                    </span>
                  ))}
                </div>
              ) : null}

              {row.explanation_public ? (
                <div
                  className="by-muted by-small"
                  style={{
                    margin: "14px 22px 0",
                    paddingLeft: 12,
                    borderLeft: "2px solid rgba(255,255,255,0.10)",
                  }}
                >
                  {row.explanation_public}
                </div>
              ) : null}

              {canDecide ? (
                <div
                  className="by-actions"
                  style={{
                    marginTop: 20,
                    padding: "16px 22px 20px",
                    borderTop: "1px solid rgba(255,255,255,0.06)",
                    background: "rgba(0,0,0,0.14)",
                  }}
                >
                  <button
                    className="by-btn by-btn-blue"
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      openDecisionModal(row, "allow")
                    }
                  >
                    Erlauben
                  </button>

                  <button
                    className="by-btn by-btn-soft"
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      openDecisionModal(row, "limit")
                    }
                  >
                    Begrenzen
                  </button>

                  <button
                    className="by-btn"
                    style={{
                      background: "#7f1d1d",
                      color: "white",
                    }}
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      openDecisionModal(
                        row,
                        "temporary_hide",
                      )
                    }
                  >
                    Temporär ausblenden
                  </button>

                  <button
                    className="by-btn"
                    style={{
                      background: "#450a0a",
                      color: "white",
                    }}
                    disabled={
                      decidingCaseId === row.case_id
                    }
                    onClick={() =>
                      openDecisionModal(row, "remove")
                    }
                  >
                    Entfernen
                  </button>
                </div>
              ) : (
                <div
                  className="by-panel"
                  style={{ margin: "18px 22px 22px" }}
                >
                  <div className="by-muted by-small">
                    Entscheidung
                  </div>
                  <strong>
                    {actionLabels[
                      row.final_action ?? ""
                    ] ??
                      row.final_action ??
                      "Noch keine Entscheidung"}
                  </strong>
                </div>
              )}
            </article>
          );
        })}

      {decisionDraft ? (
        <div
          role="presentation"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              closeDecisionModal();
            }
          }}
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 1000,
            display: "grid",
            placeItems: "center",
            padding: 28,
            background: "rgba(0, 0, 0, 0.78)",
            backdropFilter: "blur(18px)",
          }}
        >
          <section
            role="dialog"
            aria-modal="true"
            aria-labelledby="safety-decision-title"
            className="by-card"
            style={{
              width: "min(680px, 100%)",
              padding: 0,
              overflow: "hidden",
              borderRadius: 24,
              border: "1px solid rgba(255,255,255,0.10)",
              background:
                "linear-gradient(180deg, rgba(20,20,24,0.98), rgba(10,10,12,0.98))",
              boxShadow:
                "0 36px 120px rgba(0, 0, 0, 0.68)",
            }}
          >
            <div
              className="by-row"
              style={{
                padding: "24px 24px 20px",
                borderBottom: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <div>
                <div
                  className="by-muted by-small"
                  style={{
                    marginBottom: 8,
                    textTransform: "uppercase",
                    letterSpacing: "0.10em",
                    fontWeight: 700,
                  }}
                >
                  Human Review
                </div>
                <h2
                  id="safety-decision-title"
                  style={{
                    margin: 0,
                    fontSize: 28,
                    lineHeight: 1.1,
                    letterSpacing: "-0.025em",
                  }}
                >
                  {decisionDraft.action === "allow"
                    ? "Inhalt erlauben"
                    : decisionDraft.action === "limit"
                      ? "Inhalt begrenzen"
                      : decisionDraft.action === "temporary_hide"
                        ? "Inhalt temporär ausblenden"
                        : "Inhalt entfernen"}
                </h2>
                <div
                  className="by-muted by-small"
                  style={{ marginTop: 8 }}
                >
                  Die Entscheidung wird versioniert und im Audit Trail
                  gespeichert.
                </div>
              </div>

              <button
                type="button"
                className="by-btn by-btn-soft"
                onClick={closeDecisionModal}
                disabled={Boolean(decidingCaseId)}
                aria-label="Dialog schließen"
                style={{
                  width: 40,
                  height: 40,
                  minWidth: 40,
                  padding: 0,
                  borderRadius: 12,
                  fontSize: 22,
                  lineHeight: 1,
                }}
              >
                ×
              </button>
            </div>

            <div style={{ padding: "22px 24px 0" }}>
              <div
                className="by-muted by-small"
                style={{
                  marginBottom: 8,
                  fontWeight: 600,
                  textTransform: "uppercase",
                  letterSpacing: "0.08em",
                }}
              >
                Betroffener Inhalt
              </div>
              <div
                className="by-panel"
                style={{
                  maxHeight: 160,
                  overflow: "auto",
                  whiteSpace: "pre-wrap",
                  lineHeight: 1.5,
                  padding: 16,
                  borderRadius: 16,
                  background: "rgba(0,0,0,0.20)",
                }}
              >
                {decisionDraft.row.text_content ||
                  "Kein Textinhalt vorhanden."}
              </div>
            </div>

            <div style={{ padding: "0 24px" }}>
            <label
              htmlFor="safety-public-explanation"
              style={{
                display: "block",
                marginTop: 22,
                fontWeight: 700,
                fontSize: 16,
              }}
            >
              Begründung
            </label>

            <div
              className="by-muted by-small"
              style={{ marginTop: 5 }}
            >
              Diese Begründung wird im Audit Trail gespeichert.
            </div>

            <textarea
              id="safety-public-explanation"
              value={decisionDraft.explanation}
              onChange={(event) =>
                setDecisionDraft((current) =>
                  current
                    ? {
                        ...current,
                        explanation:
                          event.target.value,
                      }
                    : current,
                )
              }
              autoFocus
              rows={4}
              disabled={Boolean(decidingCaseId)}
              style={{
                width: "100%",
                marginTop: 10,
                resize: "vertical",
                minHeight: 120,
                borderRadius: 16,
                border:
                  "1px solid rgba(255,255,255,0.12)",
                background: "rgba(255,255,255,0.04)",
                color: "inherit",
                padding: 14,
                font: "inherit",
                lineHeight: 1.45,
                outline: "none",
              }}
            />
            </div>

            <div
              className="by-actions"
              style={{
                justifyContent: "flex-end",
                marginTop: 24,
                padding: "18px 24px 22px",
                borderTop: "1px solid rgba(255,255,255,0.06)",
                background: "rgba(0,0,0,0.16)",
              }}
            >
              <button
                type="button"
                className="by-btn by-btn-soft"
                onClick={closeDecisionModal}
                disabled={Boolean(decidingCaseId)}
              >
                Abbrechen
              </button>

              <button
                type="button"
                className={
                  decisionDraft.action === "allow"
                    ? "by-btn by-btn-blue"
                    : "by-btn"
                }
                onClick={() => void submitDecision()}
                disabled={
                  Boolean(decidingCaseId) ||
                  !decisionDraft.explanation.trim()
                }
                style={
                  decisionDraft.action === "remove"
                    ? {
                        background: "#450a0a",
                        color: "white",
                      }
                    : decisionDraft.action ===
                        "temporary_hide"
                      ? {
                          background: "#7f1d1d",
                          color: "white",
                        }
                      : undefined
                }
              >
                {decidingCaseId
                  ? "Wird gespeichert…"
                  : `${actionLabels[decisionDraft.action]} bestätigen`}
              </button>
            </div>
          </section>
        </div>
      ) : null}

    </div>
  );
}
