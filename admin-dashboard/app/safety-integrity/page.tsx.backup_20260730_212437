                    ? "Inhalt erlauben"
                    : decisionDraft.action === "limit"
                      ? "Inhalt begrenzen"
                      : decisionDraft.action ===
                          "temporary_hide"
                        ? "Inhalt ausblenden"
                        : "Inhalt entfernen"}
                </h2>
              </div>

              <button
                type="button"
                onClick={closeDecisionModal}
                disabled={Boolean(decidingCaseId)}
                aria-label="Schließen"
                style={{
                  width: 40,
                  height: 40,
                  minWidth: 40,
                  borderRadius: 12,
                  border:
                    "1px solid rgba(255,255,255,0.10)",
                  background:
                    "rgba(255,255,255,0.04)",
                  color: "inherit",
                  fontSize: 20,
                  cursor: "pointer",
                }}
              >
                ×
              </button>
            </div>

            <div style={{ padding: "22px 26px 0" }}>
              <div
                style={{
                  fontSize: 12,
                  fontWeight: 800,
                  textTransform: "uppercase",
                  letterSpacing: "0.08em",
                  color: "#9da4af",
                  marginBottom: 8,
                }}
              >
                Betroffener Inhalt
              </div>

              <div
                style={{
                  padding: 16,
                  borderRadius: 16,
                  background: "rgba(0,0,0,0.24)",
                  border:
                    "1px solid rgba(255,255,255,0.07)",
                  whiteSpace: "pre-wrap",
                  lineHeight: 1.5,
                }}
              >
                {decisionDraft.row.text_content ||
                  "Kein Textinhalt vorhanden."}
              </div>
            </div>

            <div style={{ padding: "22px 26px 0" }}>
              <label
                htmlFor="decision-explanation"
                style={{
                  display: "block",
                  fontWeight: 800,
                  marginBottom: 6,
                }}
              >
                Begründung
              </label>

              <div
                className="by-muted by-small"
                style={{ marginBottom: 10 }}
              >
                Wird im Audit Trail gespeichert und kann
                später für Appeals verwendet werden.
              </div>

              <textarea
                id="decision-explanation"
                value={decisionDraft.explanation}
                onChange={(event) =>
                  setDecisionDraft((current) =>
                    current
                      ? {
                          ...current,
                          explanation:
                            event.target.value,
                        }
                      : current,
                  )
                }
                autoFocus
                rows={5}
                disabled={Boolean(decidingCaseId)}
                style={{
                  width: "100%",
                  minHeight: 132,
                  resize: "vertical",
                  borderRadius: 16,
                  border:
                    "1px solid rgba(255,255,255,0.10)",
                  background:
                    "rgba(255,255,255,0.035)",
                  color: "inherit",
                  padding: 15,
                  font: "inherit",
                  lineHeight: 1.5,
                  outline: "none",
                }}
              />
            </div>

            <div
              style={{
                marginTop: 24,
                padding: "18px 26px 22px",
                display: "flex",
                justifyContent: "flex-end",
                gap: 10,
                borderTop:
                  "1px solid rgba(255,255,255,0.06)",
                background: "rgba(0,0,0,0.16)",
              }}
            >
              <button
                type="button"
                className="by-btn by-btn-soft"
                onClick={closeDecisionModal}
                disabled={Boolean(decidingCaseId)}
              >
                Abbrechen
              </button>

              <button
                type="button"
                className={
                  decisionDraft.action === "allow"
                    ? "by-btn by-btn-blue"
                    : "by-btn"
                }
                onClick={() =>
                  void submitDecision()
                }
                disabled={
                  Boolean(decidingCaseId) ||
                  !decisionDraft.explanation.trim()
                }
                style={
                  decisionDraft.action === "remove"
                    ? {
                        background: "#450a0a",
                        color: "white",
                      }
                    : decisionDraft.action ===
                        "temporary_hide"
                      ? {
                          background: "#7f1d1d",
                          color: "white",
                        }
                      : undefined
                }
              >
                {decidingCaseId
                  ? "Wird gespeichert…"
                  : "Entscheidung bestätigen"}
              </button>
            </div>
          </section>
        </div>
      ) : null}
    </div>
  );
}
