  hate: "Hass oder Diskriminierung",
  harassment: "Belästigung oder Ausgrenzung",
  violence: "Gewalt",
  sexual: "Sexuelle Inhalte",
  self_harm: "Selbstgefährdung",
  illicit: "Illegale oder gefährliche Inhalte",
