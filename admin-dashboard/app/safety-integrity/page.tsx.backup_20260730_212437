        <div
          style={{
            display: "flex",
            alignItems: "center",
            gap: 8,
            color: "#ff4f8b",
            fontSize: 13,
            fontWeight: 700,
            letterSpacing: "0.08em",
            textTransform: "uppercase",
            marginBottom: 12,
          }}
        >
          Trust & Safety Operations
        </div>

        <h1
          className="by-title"
          style={{
            margin: 0,
            fontSize: "clamp(38px, 4vw, 58px)",
            lineHeight: 1,
            letterSpacing: "-0.045em",
          }}
