    if (!decisionDraft) return;

    const { row, action, explanation } =
      decisionDraft;

    setDecidingCaseId(row.case_id);
    setError("");

    const { error: decisionError } =
      await supabase.rpc(
        "safety_admin_decide_v1",
        {
          p_case_id: row.case_id,
          p_action: action,
          p_category: row.final_category,
          p_severity: row.final_severity,
          p_confidence:
            row.final_confidence === null
              ? null
              : Number(row.final_confidence),
          p_public_explanation:
            explanation.trim() || null,
          p_internal_explanation:
            "Human review via Backyrd Safety & Integrity Enterprise UI.",
          p_reason_codes: [
            "HUMAN_REVIEW",
            `HUMAN_ACTION_${action.toUpperCase()}`,
          ],
        },
      );

    if (decisionError) {
      setError(decisionError.message);
      setDecidingCaseId(null);
      return;
    }

    setDecisionDraft(null);
    setDecidingCaseId(null);
    await load();
  }

