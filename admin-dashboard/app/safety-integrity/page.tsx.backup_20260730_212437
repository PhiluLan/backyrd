  none: "Keine Unterkategorie",
};

const reasonLabels: Record<string, string> = {
  NO_POLICY_VIOLATION: "Kein Richtlinienverstoß",
  AMBIGUOUS_GROUP_TARGET: "Zielgruppe nicht eindeutig",
  EXCLUSION_LANGUAGE: "Ausgrenzende Sprache",
  HUMAN_CONTEXT_REQUIRED: "Kontextprüfung nötig",
  LOCAL_POLICY_MATCH: "Backyrd-Regel erkannt",
  SHADOW_MODE: "Shadow Mode",
  PROTECTED_CHARACTERISTIC: "Geschütztes Merkmal",
  DENIAL_OF_ACCESS_OR_SERVICE: "Zutritt oder Service verweigert",
  DISCRIMINATORY_EXCLUSION: "Diskriminierender Ausschluss",
  MODEL_FLAGGED: "Vom Moderationsmodell markiert",
  CATEGORY_THRESHOLD_REACHED: "Risikoschwelle erreicht",
};

function formatConfidence(
  value: number | string | null,
): string {
  if (value === null || value === undefined) {
    return "—";
  }

  const parsed = Number(value);

  return Number.isFinite(parsed)
    ? `${Math.round(parsed * 100)} %`
    : "—";
}

function relativeTime(value: string): string {
  const created = new Date(value).getTime();
  const now = Date.now();
  const diffMinutes = Math.max(
    0,
    Math.round((now - created) / 60000),
  );

  if (diffMinutes < 1) return "gerade eben";
  if (diffMinutes < 60)
    return `vor ${diffMinutes} Min.`;

  const hours = Math.round(diffMinutes / 60);

  if (hours < 24) return `vor ${hours} Std.`;

  const days = Math.round(hours / 24);
  return `vor ${days} ${days === 1 ? "Tag" : "Tagen"}`;
}

function getMetadataString(
  metadata: Record<string, unknown> | null | undefined,
  key: string,
): string | null {
  const value = metadata?.[key];
  return typeof value === "string" ? value : null;
}

function humanizeCode(code: string): string {
  return (
    reasonLabels[code] ??
    code
      .toLowerCase()
      .split("_")
      .map(
        (part) =>
          part.charAt(0).toUpperCase() + part.slice(1),
      )
      .join(" ")
  );
}

function splitContent(text: string | null) {
  const lines = (text ?? "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  return {
    title: lines[0] ?? "Unbekannter Spot",
    body:
      lines.length > 1
        ? lines.slice(1).join("\n")
        : lines[0] ?? "",
  };
}

function contentTypeLabel(contentType: string): string {
  switch (contentType) {
    case "owner_spot_profile":
      return "Spot-Profiländerung";
    case "owner_spot_intelligence":
      return "Spot-Inhalte & Empfehlungen";
    default:
      return "Inhaltsänderung";
  }
}

function severityLabel(severity: number | null): string {
  const value = severity ?? 0;

  if (value >= 5) return "Kritisch";
  if (value >= 4) return "Hoch";
  if (value >= 3) return "Mittel";
  if (value >= 1) return "Niedrig";
  return "Unauffällig";
}

function severityColor(severity: number | null): string {
  const value = severity ?? 0;

  if (value >= 4) return "#ff6b6b";
  if (value >= 3) return "#ffb454";
  if (value >= 1) return "#ffd166";
  return "#8fa3b8";
}

export default function SafetyIntegrityPage() {
  const [rows, setRows] = useState<SafetyRow[]>([]);
  const [status, setStatus] =
    useState<QueueStatus>("needs_review");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(true);
  const [decidingCaseId, setDecidingCaseId] =
    useState<string | null>(null);
  const [decisionDraft, setDecisionDraft] =
    useState<DecisionDraft>(null);

  async function load() {
    setLoading(true);
    setError("");

    const { data, error: loadError } =
      await supabase.rpc("safety_admin_queue_v2", {
        p_status: status === "all" ? null : status,
        p_limit: 250,
      });

    if (loadError) {
      setError(loadError.message);
      setRows([]);
    } else {
      setRows((data ?? []) as SafetyRow[]);
    }

    setLoading(false);
  }

  useEffect(() => {
    void load();
  }, [status]);

  const openCount = useMemo(
    () =>
      rows.filter(
        (row) => row.case_status === "needs_review",
      ).length,
    [rows],
  );

  function defaultExplanation(
    action: ModerationAction,
  ): string {
    const defaults: Record<
      ModerationAction,
      string
