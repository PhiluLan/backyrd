              style={{ marginTop: 8 }}
            >
              Neue Fälle erscheinen hier automatisch.
            </div>
          </div>
        </div>
      ) : null}

      {view === "cases" ? (
        <div style={{ display: "grid", gap: 18 }}>
          {!loading &&
            cases.map((row) => {
