function relativeTime(value: string): string {
  const created = new Date(value).getTime();
  const diffMinutes = Math.max(
    0,
    Math.round((Date.now() - created) / 60000),
  );

  if (diffMinutes < 1) return "gerade eben";
  if (diffMinutes < 60) return `vor ${diffMinutes} Min.`;

  const hours = Math.round(diffMinutes / 60);
  if (hours < 24) return `vor ${hours} Std.`;

  const days = Math.round(hours / 24);
  return `vor ${days} ${days === 1 ? "Tag" : "Tagen"}`;
}

function splitContent(text: string | null) {
  const lines = (text ?? "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  return {
    title: lines[0] ?? "Unbekannter Inhalt",
    body:
      lines.length > 1
        ? lines.slice(1).join("\n")
        : lines[0] ?? "",
  };
}

function contentTypeLabel(contentType: string): string {
  switch (contentType) {
    case "owner_spot_profile":
      return "Spot-Profiländerung";
    case "owner_spot_intelligence":
      return "Spot-Inhalte & Empfehlungen";
    case "review":
      return "Review";
    case "comment":
      return "Kommentar";
    case "profile":
      return "Nutzerprofil";
    default:
      return "Inhaltsänderung";
  }
}

function severityLabel(severity: number | null): string {
  const value = severity ?? 0;
  if (value >= 5) return "Kritisch";
  if (value >= 4) return "Hoch";
  if (value >= 3) return "Mittel";
  if (value >= 1) return "Niedrig";
  return "Unauffällig";
}

function severityColor(severity: number | null): string {
  const value = severity ?? 0;
  if (value >= 4) return "#ff6b6b";
  if (value >= 3) return "#ffb454";
  if (value >= 1) return "#ffd166";
  return "#8fa3b8";
}

function StatusPill({
  label,
  tone = "neutral",
}: {
  label: string;
  tone?: "neutral" | "warning" | "success" | "danger" | "pink";
}) {
  const tones = {
    neutral: {
      color: "#c4cad4",
      background: "rgba(255,255,255,0.04)",
      border: "rgba(255,255,255,0.09)",
    },
    warning: {
      color: "#ffbd63",
      background: "rgba(255,184,84,0.08)",
      border: "rgba(255,184,84,0.20)",
    },
    success: {
      color: "#78dda6",
      background: "rgba(66,201,125,0.08)",
      border: "rgba(66,201,125,0.20)",
    },
    danger: {
      color: "#ff8585",
      background: "rgba(255,85,85,0.08)",
      border: "rgba(255,85,85,0.20)",
    },
    pink: {
      color: "#ff6d9f",
      background: "rgba(255,79,139,0.10)",
      border: "rgba(255,79,139,0.24)",
    },
  }[tone];

  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        padding: "7px 10px",
        borderRadius: 999,
        border: `1px solid ${tones.border}`,
        background: tones.background,
        color: tones.color,
        fontSize: 12,
        fontWeight: 800,
        whiteSpace: "nowrap",
      }}
    >
      {label}
    </span>
  );
}

export default function SafetyIntegrityPage() {
  const [view, setView] = useState<ConsoleView>("cases");
  const [caseStatus, setCaseStatus] =
    useState<QueueStatus>("needs_review");
  const [reportStatus, setReportStatus] = useState("all");
  const [appealStatus, setAppealStatus] = useState("submitted");

  const [cases, setCases] = useState<SafetyRow[]>([]);
  const [reports, setReports] = useState<ReportRow[]>([]);
  const [appeals, setAppeals] = useState<AppealRow[]>([]);

  const [error, setError] = useState("");
  const [decisionErrorText, setDecisionErrorText] = useState("");
  const [loading, setLoading] = useState(true);
  const [workingId, setWorkingId] = useState<string | null>(null);

  const [decisionDraft, setDecisionDraft] =
    useState<DecisionDraft>(null);
  const [appealDraft, setAppealDraft] =
    useState<AppealDraft>(null);

  async function loadCases() {
    const { data, error: loadError } = await supabase.rpc(
      "safety_admin_queue_v2",
      {
        p_status: caseStatus === "all" ? null : caseStatus,
        p_limit: 250,
      },
    );

    if (loadError) throw loadError;
    setCases((data ?? []) as SafetyRow[]);
  }

  async function loadReports() {
    const { data, error: loadError } = await supabase.rpc(
      "safety_admin_reports_queue_v1",
      {
        p_status: reportStatus === "all" ? null : reportStatus,
        p_limit: 250,
      },
    );

    if (loadError) throw loadError;
    setReports((data ?? []) as ReportRow[]);
  }

  async function loadAppeals() {
    const { data, error: loadError } = await supabase.rpc(
      "safety_admin_appeals_queue_v1",
      {
        p_status: appealStatus === "all" ? null : appealStatus,
        p_limit: 250,
      },
    );

    if (loadError) throw loadError;
    setAppeals((data ?? []) as AppealRow[]);
  }

  async function load() {
    setLoading(true);
    setError("");

    try {
      if (view === "cases") await loadCases();
      if (view === "reports") await loadReports();
      if (view === "appeals") await loadAppeals();
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "Daten konnten nicht geladen werden.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void load();
  }, [view, caseStatus, reportStatus, appealStatus]);

  const visibleCount = useMemo(() => {
    if (view === "cases") return cases.length;
    if (view === "reports") return reports.length;
    return appeals.length;
  }, [view, cases, reports, appeals]);

  function openDecisionModal(
    row: SafetyRow,
    action: ModerationAction,
  ) {
    const defaults: Record<ModerationAction, string> = {
      allow:
        "Der Inhalt verstößt nicht gegen die Backyrd-Richtlinien.",
      limit:
        "Der Inhalt wurde nach menschlicher Prüfung begrenzt.",
      temporary_hide:
        "Der Inhalt wurde vorübergehend ausgeblendet und wird weiter geprüft.",
      remove:
        "Der Inhalt wurde nach menschlicher Prüfung entfernt.",
    };

    setDecisionErrorText("");
    setDecisionDraft({
      row,
      action,
      explanation: defaults[action],
    });
  }

  async function submitDecision() {
    if (!decisionDraft) return;

    const { row, action, explanation } = decisionDraft;
    setWorkingId(row.case_id);
    setError("");

    const decisionRpc =
      row.entity_type === "spot_owner_change"
        ? "safety_admin_decide_v1"
        : "safety_admin_decide_user_content_v1";

    const { error: decisionError } = await supabase.rpc(
      decisionRpc,
      {
        p_case_id: row.case_id,
        p_action: action,
        p_category: row.final_category,
        p_severity: row.final_severity,
        p_confidence:
          row.final_confidence === null
            ? null
            : Number(row.final_confidence),
        p_public_explanation: explanation.trim() || null,
        p_internal_explanation:
          "Human review via Safety V3 Admin Console.",
        p_reason_codes: [
          "HUMAN_REVIEW",
          `HUMAN_ACTION_${action.toUpperCase()}`,
        ],
      },
    );

    if (decisionError) {
      setDecisionErrorText(decisionError.message);
      setWorkingId(null);
      return;
    }

    setDecisionErrorText("");
    setDecisionDraft(null);
    setWorkingId(null);
    await load();
  }

  function openAppealModal(
    row: AppealRow,
    outcome: "upheld" | "overturned" | "modified",
  ) {
    setAppealDraft({
      row,
      outcome,
      replacementAction: outcome === "modified" ? "limit" : "",
      reviewerNote:
        outcome === "upheld"
          ? "Die ursprüngliche Entscheidung bleibt bestehen."
          : outcome === "overturned"
            ? "Der Einspruch wurde angenommen und die ursprüngliche Entscheidung aufgehoben."
            : "Die ursprüngliche Maßnahme wurde nach erneuter Prüfung angepasst.",
    });
  }

  async function submitAppealDecision() {
    if (!appealDraft) return;

    const {
      row,
      outcome,
      reviewerNote,
      replacementAction,
    } = appealDraft;

    setWorkingId(row.appeal_id);
    setError("");

    const { error: appealError } = await supabase.rpc(
      "safety_admin_decide_appeal_v1",
      {
        p_appeal_id: row.appeal_id,
        p_outcome: outcome,
        p_reviewer_note: reviewerNote.trim(),
        p_replacement_action:
          outcome === "modified" ? replacementAction : null,
      },
    );

    if (appealError) {
      setError(appealError.message);
      setWorkingId(null);
      return;
    }

    setAppealDraft(null);
    setWorkingId(null);
    await load();
  }

  const filterOptions =
    view === "cases"
      ? CASE_STATUS_OPTIONS
      : view === "reports"
        ? REPORT_STATUS_OPTIONS
        : APPEAL_STATUS_OPTIONS;

  const activeFilter =
    view === "cases"
      ? caseStatus
      : view === "reports"
        ? reportStatus
        : appealStatus;

  function setActiveFilter(value: string) {
    if (view === "cases") setCaseStatus(value as QueueStatus);
    if (view === "reports") setReportStatus(value);
    if (view === "appeals") setAppealStatus(value);
  }

  return (
    <div
      className="by-page"
      style={{
        padding: "32px 34px 56px",
        maxWidth: 1560,
        margin: "0 auto",
      }}
    >
      <header style={{ marginBottom: 28 }}>
        <div
          style={{
            color: "#ff4f8b",
            fontSize: 13,
            fontWeight: 800,
            letterSpacing: "0.08em",
            textTransform: "uppercase",
            marginBottom: 12,
          }}
        >
          Trust & Safety Operations
        </div>

        <h1
          className="by-title"
          style={{
            margin: 0,
            fontSize: "clamp(38px, 4vw, 58px)",
            lineHeight: 1,
            letterSpacing: "-0.045em",
          }}
        >
          Safety & Integrity
        </h1>

        <p
          className="by-subtitle"
          style={{
            maxWidth: 780,
            margin: "16px 0 0",
            fontSize: 17,
            lineHeight: 1.6,
          }}
        >
          Prüfe automatische Treffer, Nutzer-Meldungen und Einsprüche
          in einer gemeinsamen, nachvollziehbaren Moderationskonsole.
        </p>
      </header>

      <nav
        className="by-card"
        style={{
          padding: 8,
          display: "inline-flex",
          gap: 6,
          marginBottom: 18,
          background: "rgba(255,255,255,0.018)",
        }}
      >
        {[
          {
            value: "cases" as ConsoleView,
            label: "Moderationsfälle",
          },
          {
            value: "reports" as ConsoleView,
            label: "Nutzer-Meldungen",
          },
          {
            value: "appeals" as ConsoleView,
            label: "Einsprüche",
          },
        ].map((item) => {
          const selected = view === item.value;

          return (
            <button
              key={item.value}
              type="button"
              onClick={() => setView(item.value)}
              style={{
                border: selected
                  ? "1px solid rgba(255,79,139,0.28)"
                  : "1px solid transparent",
                background: selected
                  ? "rgba(255,79,139,0.10)"
                  : "transparent",
                color: selected ? "#ff6d9f" : "inherit",
                borderRadius: 12,
                padding: "11px 16px",
                font: "inherit",
                fontWeight: 800,
                cursor: "pointer",
              }}
            >
              {item.label}
            </button>
          );
        })}
      </nav>

      <section
        className="by-card"
        style={{
          padding: 10,
          marginBottom: 22,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          gap: 14,
          background: "rgba(255,255,255,0.018)",
        }}
      >
        <div
          style={{
            display: "flex",
            gap: 6,
            flexWrap: "wrap",
          }}
        >
          {filterOptions.map((option) => {
            const selected = activeFilter === option.value;

            return (
              <button
                key={option.value}
                type="button"
                onClick={() => setActiveFilter(option.value)}
                style={{
                  border: selected
                    ? "1px solid rgba(255,255,255,0.12)"
