        </div>
      </section>

      {error ? (
        <div
          className="by-card"
          style={{
            padding: 18,
            marginBottom: 18,
            color: "#ff7a7a",
          }}
        >
          {error}
        </div>
      ) : null}

      {!loading && visibleCount === 0 ? (
        <div
          className="by-card"
          style={{
            minHeight: 300,
            display: "grid",
            placeItems: "center",
            textAlign: "center",
            padding: 32,
