{
  "version": "backyrd-production-auth-config-v1",
  "projectRef": "hjgcrrzfjchzqoegcywn",
  "config": {
    "site_url": "https://www.backyrd.ch",
    "uri_allow_list": "https://www.backyrd.ch/auth/callback**,backyrd://auth/**",
    "password_min_length": 8,
    "mailer_subjects_confirmation": "Dein Backyrd Code ist da",
    "mailer_subjects_recovery": "Setze dein Backyrd Passwort zurück",
    "mailer_templates_confirmation_content": "<!doctype html><html lang=\"de\"><head><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"></head><body style=\"margin:0;padding:0;background:#050506;color:#f6f2ef;font-family:Arial,Helvetica,sans-serif\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#050506\"><tr><td align=\"center\" style=\"padding:36px 18px 48px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:520px\"><tr><td style=\"padding:0 0 48px\"><span style=\"display:inline-block;background:#fa4189;border-radius:12px;color:#050506;font-size:22px;font-weight:700;line-height:44px;text-align:center;width:44px\">B</span><span style=\"padding-left:12px;color:#f6f2ef;font-size:16px;font-weight:700;letter-spacing:1px\">BACKYRD</span></td></tr><tr><td style=\"color:#fa4189;font-size:11px;font-weight:700;letter-spacing:3px;padding-bottom:14px\">DEIN NÄCHSTER MOMENT</td></tr><tr><td style=\"color:#f6f2ef;font-size:38px;font-weight:700;line-height:1.12;padding-bottom:20px\">Fast dabei.</td></tr><tr><td style=\"color:#b8b4b7;font-size:16px;line-height:1.6;padding-bottom:32px\">{{ if eq .RedirectTo \"backyrd://auth/callback\" }}Bestätige deine E-Mail-Adresse mit diesem Code in der Backyrd App.{{ else }}Bestätige deine E-Mail-Adresse, damit du deinen Account sicher verwenden kannst.{{ end }}</td></tr><tr><td style=\"background:#19171a;border:1px solid #383238;border-radius:20px;padding:28px;text-align:center\"><div style=\"color:#a9a2a8;font-size:11px;font-weight:700;letter-spacing:2px;padding-bottom:12px\">DEIN BESTÄTIGUNGSCODE</div><div style=\"color:#f6f2ef;font-size:38px;font-weight:700;letter-spacing:8px;line-height:1.2\">{{ .Token }}</div></td></tr><tr><td style=\"padding-top:32px\"><a href=\"{{ if eq .RedirectTo \"backyrd://auth/callback\" }}https://www.backyrd.ch/auth/verify{{ else }}{{ .ConfirmationURL }}{{ end }}\" style=\"display:block;background:#fa4189;border-radius:16px;color:#050506;font-size:16px;font-weight:700;line-height:22px;padding:17px 22px;text-align:center;text-decoration:none\">{{ if eq .RedirectTo \"backyrd://auth/callback\" }}App öffnen &amp; Code eingeben{{ else }}E-Mail-Adresse bestätigen{{ end }}</a></td></tr><tr><td style=\"color:#a9a2a8;font-size:13px;line-height:1.6;padding-top:24px\">{{ if eq .RedirectTo \"backyrd://auth/callback\" }}Falls sich Backyrd nicht öffnet, starte die App selbst und wähle „E-Mail bestätigen“. Gib dort deine E-Mail-Adresse und den Code ein.{{ else }}Mit dem Button bestätigst du deine E-Mail-Adresse und gelangst zurück zu Backyrd.{{ end }}</td></tr><tr><td style=\"border-top:1px solid #383238;color:#8c858b;font-size:12px;line-height:1.6;padding-top:24px\">Du hast keinen Backyrd Account erstellt? Dann kannst du diese Nachricht ignorieren. Teile den Code mit niemandem.</td></tr></table></td></tr></table></body></html>",
    "mailer_templates_recovery_content": "<h2>Backyrd Passwort zurücksetzen</h2><p>Öffne den sicheren Link, um ein neues Passwort zu wählen.</p><p><a href=\"{{ .ConfirmationURL }}\">Neues Passwort wählen</a></p><p>Wenn du das nicht angefordert hast, kannst du diese Nachricht ignorieren.</p>"
  }
}
