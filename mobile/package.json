{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node ./scripts/test-mobile-product-contracts.mjs && npm run test:native-intent",
    "test:map-discovery": "node ./scripts/test-map-discovery-scale.mjs",
    "test:canonical-spot-images": "node ./scripts/test-canonical-spot-images.mjs",
    "test:native-intent": "node --test ./scripts/test-native-intent-routing.mjs ./scripts/test-ios-link-handoff.mjs ./scripts/test-notification-routing.mjs",
    "test:carousel-geometry": "node ./scripts/test-carousel-geometry.mjs",
    "test:production-images": "node ./scripts/validate-production-images.mjs",
    "release:validate": "node ./scripts/validate-production-release.mjs",
    "release:verify:ios-ipa": "node ./scripts/validate-ios-bundle-identifiers.mjs",
    "release:export:ios": "BACKYRD_RELEASE_BUILD=1 APP_VARIANT=prod npm run release:validate && expo export --platform ios",
    "release:ota:production": "BACKYRD_RELEASE_BUILD=1 APP_VARIANT=prod npm run release:validate && eas update --channel production --environment production",
    "release:build:ios": "BACKYRD_RELEASE_BUILD=1 APP_VARIANT=prod npm run release:validate && eas build --platform ios --profile production",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.95.3",
    "base-64": "^1.0.0",
    "base64-arraybuffer": "^1.0.2",
    "dotenv": "^17.2.3",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.7",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.9",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "node-fetch": "^3.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "volta": {
    "node": "20.19.4"
  }
}
